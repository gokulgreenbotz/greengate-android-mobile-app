<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- Resident sign-in: device id and encrypted refresh token belong to this install only. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="resident_session.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="resident_session.xml"/>
    </device-transfer>
</data-extraction-rules>